{
  "name": "galgod-miband-10",
  "version": "1.1.2",
  "description": "《想成为Galgame领域大神！！！》小米手环移植版 —— 内容来自 mcpotato1123/galgod-band，引擎与 UI 采用 Sanoba-Witch-MiBand-10 的 VnEngine",
  "author": "hrk_",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release --enable-jsc",
    "test": "node tests/run-tests.mjs",
    "validate": "python3 tools/validate_galgod.py",
    "simulate": "python3 tools/simulate_galgod.py .",
    "convert": "python3 tools/convert_galgod.py ../galgod-band . && python3 tools/convert_assets.py ../galgod-band . && python3 tools/gen_game_config.py .",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/"
  },
  "lint-staged": {
    "*.{ux,js}": [
      "prettier --write",
      "eslint --format codeframe --fix",
      "git add"
    ],
    "*.{less,css}": [
      "prettier --write",
      "stylelint --fix --custom-syntax postcss-less",
      "git add"
    ]
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5"
  }
}
