          </div>
        </div>
      </div>

      <!-- 信息列表 -->
      <div class="card">
        <text class="info-label">作者</text>
        <text class="info-value">hrk_</text>
      </div>
      <div class="card">
        <text class="info-label">协议</text>
        <text class="info-value">代码 GPL-3.0（素材不在此协议范围内）</text>
      </div>
      <div class="card">
