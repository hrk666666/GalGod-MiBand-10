<script>
import router from "@system.router"
import manifest from "../../manifest.json"
import {DEBUG} from "../../common/constants.js"
import {vibrateShort} from "../../common/vibrate.js"

export default {
  private: {
    appVersion: ""
  },

  onInit() {
    this.appVersion = manifest.versionName
  },

  swipeBack() {
    vibrateShort()
    router.back()
  },

  longPressBack() {
    if (DEBUG) router.back()
  },

  routeLoad() {
    vibrateShort()
    router.push({uri: "pages/data"})
  }
}
</script>

