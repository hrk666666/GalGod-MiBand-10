<template>
  <div class="page" @swipe="swipeBack" @longpress="longPressBack">
    <image class="bg-image" src="/common/title_bg.jpg"></image>

    <!-- 顶部标题 -->
    <div class="header">
      <text class="header-title">关于</text>
    </div>

    <scroll scroll-y="true" class="list">
      <!-- 应用信息卡片 -->
      <div class="card">
        <div class="app-row">
          <image class="app-icon" src="/common/logo.png"></image>
          <div class="app-info">
